{
  "controller": {
    "url": "",
    "api_prefix": "/api/v0",
    "api_token": "",
    "env": "",
    "role": "powdet",
    "instance_id": "",
    "app_name": "powdet",
    "app_version": ""
  },
  "internal_api_token": "REPLACE_WITH_INTERNAL_TOKEN",
  "enabled": true,
  "listenPort": 2370,
  "batchSize": 1000,
  "deprecateAfterBatches": 10,
  "algorithms": {
    "argon2id": {
      "enabled": true,
      "memoryKiB": 16384,
      "iterations": 2,
      "parallelism": 1,
      "keyLength": 16
    },
    "randomx": {
      "enabled": false,
      "jit": true,
      "hardAes": true,
      "largePages": false,
      "seedLen": 32,
      "cacheLRUSize": 128,
      "cacheTTL": 600
    }
  },
  "adminApiToken": "REPLACE_WITH_ADMIN_TOKEN"
}
